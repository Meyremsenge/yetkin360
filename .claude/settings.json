{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/node_modules/**)",
      "Read(**/.venv/**)",
      "Read(**/venv/**)",
      "Read(**/__pycache__/**)",
      "Read(**/.pytest_cache/**)",
      "Read(**/.next/**)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/coverage/**)",
      "Read(**/htmlcov/**)",
      "Read(**/*.log)",
      "Read(**/logs/**)",
      "Read(**/package-lock.json)",
      "Read(**/poetry.lock)",
      "Read(**/uv.lock)",
      "Read(**/*.sqlite)",
      "Read(**/*.db)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/secrets/**)",
      "Bash(git add -A)",
      "Bash(git add .)",
      "Bash(git push --force:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker-compose down -v:*)",
      "Bash(rm -rf /:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(alembic upgrade:*)",
      "Bash(alembic downgrade:*)",
      "Bash(alembic revision:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(rm:*)",
      "Bash(docker compose down:*)",
      "Edit(**/migrations/**)",
      "Edit(**/alembic/**)",
      "Edit(docker-compose*.yml)",
      "Edit(.github/workflows/**)",
      "Edit(.claude/settings.json)",
      "Edit(CLAUDE.md)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log --oneline:*)",
      "Bash(pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(mypy:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm run build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "outputStyle": "concise"
}
